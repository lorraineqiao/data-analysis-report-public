[project]
sub_id = "53f71bac"
name = "projects"
requires = ["nodejs-24"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "./scripts/prepare.sh"]
run = ["bash", "./scripts/dev.sh"]
deps = ["git"]

[deploy]
build = ["bash", "./scripts/build.sh"]
run = ["bash", "./scripts/start.sh"]
deps = ["git"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["."]
